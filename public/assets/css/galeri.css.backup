
/* ==========================================================================
   GALERI & DOKUMENTASI
   ========================================================================== */

.gallery {
  padding: 0 0 80px;
}

.gallery__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 32px;
  margin-bottom: 36px;
  padding-bottom: 24px;
  border-bottom: 1px solid rgba(60, 24, 8, 0.2);
}

.gallery__intro {
  max-width: 720px;
}

.gallery__title {
  margin: 12px 0 0;
  font-family: var(--serif);
  font-size: clamp(32px, 4vw, 56px);
  line-height: 1.1;
  color: var(--brown);
}

.gallery__lead {
  max-width: 680px;
  margin: 14px 0 0;
  color: rgba(60, 24, 8, 0.74);
  font-size: 17px;
  line-height: 1.7;
}

/* ==========================================================================
   GALERI UTAMA
   Setiap baris adalah grid sendiri agar komposisi desktop rapi dan
   tetap dapat menampung jumlah foto yang berbeda-beda.
   ========================================================================== */

.gallery-grid {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.gallery-row {
  display: grid;
  gap: 28px;
  min-width: 0;
}

.gallery-row > * {
  min-width: 0;
}

.gallery-row--lead {
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
}

.gallery-row--split {
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
}

.gallery-row--strip {
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
}

.gallery-card {
  min-width: 0;
  margin: 0;
  overflow: hidden;
  background: var(--paper);
  border: 1px solid rgba(60, 24, 8, 0.25);
}

.gallery-card__media {
  width: 100%;
  aspect-ratio: 3 / 2;
  overflow: hidden;
  background: #f0eadc;
  border: 1px solid var(--brown);
}

.gallery-card__media img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
  transition: transform 0.35s ease;
}

.gallery-card:hover .gallery-card__media img {
  transform: scale(1.03);
}

.gallery-card__body {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 18px 20px;
  color: var(--brown);
  border-top: 1px solid rgba(60, 24, 8, 0.15);
}

.gallery-card__index {
  width: 30px;
  height: 30px;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--amber);
  font-size: 12px;
  font-weight: 700;
}

.gallery-card__title {
  font-size: 15px;
  font-weight: 600;
  line-height: 1.5;
}

/* ==========================================================================
   FOTO UTAMA DETAIL KEGIATAN
   ========================================================================== */

.activity-feature {
  padding-bottom: 72px;
}

.activity-feature__figure {
  width: 100%;
  margin: 0;
}

.activity-feature__media {
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: #f0eadc;
  border: 1px solid var(--brown);
}

.activity-feature__media img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
}

.activity-feature__caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 20px 0;
  border-bottom: 1px solid rgba(60, 24, 8, 0.2);
}

.activity-feature__caption p {
  margin: 0;
  color: var(--brown);
  font-weight: 600;
  text-align: right;
}

/* ==========================================================================
   CERITA KEGIATAN
   ========================================================================== */

.activity-story {
  padding: 72px 0;
  background: var(--paper);
}

.activity-story__layout {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 72px;
  align-items: start;
}

.activity-story__heading h2 {
  margin: 12px 0 0;
  font-family: var(--serif);
  font-size: clamp(30px, 4vw, 48px);
  line-height: 1.15;
  color: var(--brown);
}

.activity-story__text {
  max-width: 680px;
  color: rgba(60, 24, 8, 0.8);
  font-size: 17px;
  line-height: 1.85;
  white-space: pre-line;
}

/* ==========================================================================
   DOKUMENTASI DETAIL KEGIATAN
   ========================================================================== */

.gallery--activity {
  padding-top: 72px;
}

.activity-gallery {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;
}

.activity-gallery__item {
  min-width: 0;
  margin: 0;
  overflow: hidden;
  background: var(--paper);
  border: 1px solid rgba(60, 24, 8, 0.25);
}

.activity-gallery__item:first-child {
  grid-column: 1 / -1;
}

.activity-gallery__item:first-child .activity-gallery__media {
  aspect-ratio: 16 / 9;
}

.activity-gallery__media {
  width: 100%;
  aspect-ratio: 3 / 2;
  overflow: hidden;
  background: #f0eadc;
  border: 1px solid var(--brown);
}

.activity-gallery__media img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center;
  transition: transform 0.35s ease;
}

.activity-gallery__item:hover .activity-gallery__media img {
  transform: scale(1.03);
}

.activity-gallery__item figcaption {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 15px 18px;
  color: var(--brown);
  border-top: 1px solid rgba(60, 24, 8, 0.15);
  font-size: 14px;
  font-weight: 600;
}

.activity-gallery__number {
  width: 28px;
  height: 28px;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--amber);
  font-size: 11px;
}

/* ==========================================================================
   TABLET
   ========================================================================== */

@media (max-width: 1024px) {
  .gallery-grid,
  .gallery-row {
    gap: 24px 20px;
  }

  .gallery-row--strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .activity-story__layout {
    gap: 40px;
  }
}

/* ==========================================================================
   MOBILE
   ========================================================================== */

@media (max-width: 768px) {
  .activity-story__layout {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .activity-feature__media {
    aspect-ratio: 4 / 3;
  }
}

@media (max-width: 640px) {
  .gallery {
    padding-bottom: 56px;
  }

  .gallery__head {
    align-items: flex-start;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 24px;
    padding-bottom: 20px;
  }

  .gallery-grid {
    gap: 24px;
  }

  .gallery-row {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .gallery-card__body {
    padding: 15px 16px;
  }

  .activity-feature {
    padding-bottom: 48px;
  }

  .activity-feature__media {
    aspect-ratio: 4 / 3;
  }

  .activity-feature__caption {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }

  .activity-feature__caption p {
    text-align: left;
  }

  .activity-story {
    padding: 48px 0;
  }

  .activity-story__text {
    font-size: 15px;
    line-height: 1.8;
  }

  .activity-gallery {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .activity-gallery__item:first-child {
    grid-column: auto;
  }

  .activity-gallery__item:first-child .activity-gallery__media {
    aspect-ratio: 4 / 3;
  }

  .gallery--activity {
    padding-top: 48px;
  }
}

/* ==========================================================================
   ACCESSIBILITY
   ========================================================================== */

@media (prefers-reduced-motion: reduce) {
  .gallery-card__media img,
  .activity-gallery__media img {
    transition: none;
  }
}
